# Superset
SUPERSET_BASE_URL=https://your-superset.example.com
SUPERSET_USERNAME=your_username
SUPERSET_PASSWORD=your_password

# GreenNode AgentBase LLM (OpenAI-compatible)
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=your_agentbase_llm_api_key
LLM_MODEL=minimax/minimax-m2.5

# Agent
# Directory containing *.md prompt files — one file per monitoring flow
PROMPTS_DIR=./prompts
RUN_LOG_DIR=./logs
API_TOKEN=your_secret_token_for_the_run_endpoint

# Teams webhook (optional — skip posting if not set)
TEAMS_WEBHOOK_URL=
